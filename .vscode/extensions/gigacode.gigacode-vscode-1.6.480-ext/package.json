{
	"name": "gigacode-vscode",
	"publisher": "GigaCode",
	"displayName": "GigaCode: AI-Powered Coding Assistant",
	"description": "%gigacode.description%",
	"version": "1.6.480-ext",
	"author": "GigaCode <gigacode@sberbank.ru>",
	"contributors": [
		"Ilya Shuklin <iashuklin@sberbank.ru>",
		"Ekaterina Zharovova <eanazharovova@sberbank.ru>"
	],
	"engines": {
		"vscode": "^1.74.0"
	},
	"repository": {
		"type": "git",
		"url": "https://stash.sigma.sbrf.ru/projects/AICODE/repos/code-completion-vscode-plugin"
	},
	"bugs": {
		"email": "support@gitverse.ru"
	},
	"categories": [
		"Machine Learning",
		"Programming Languages",
		"Snippets",
		"Education",
		"Other"
	],
	"keywords": [
		"javascript",
		"python",
		"typescript",
		"php",
		"autocomplete",
		"chat",
		"code completion",
		"ruby",
		"java",
		"go",
		"golang",
		"bash",
		"kotlin",
		"html",
		"css",
		"ocaml",
		"perl",
		"rust",
		"julia",
		"lua",
		"haskell",
		"c",
		"cpp",
		"c++",
		"csharp",
		"c#",
		"react",
		"swift",
		"method completion",
		"intellicode",
		"intellisense",
		"snippets",
		"jupyter",
		"nodejs",
		"node",
		"node.js",
		"documentation",
		"AI",
		"AI-assisted code completion",
		"AI-powered coding assistant",
		"code suggestion",
		"code prediction",
		"unit test generation",
		"documentation generation"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"icon": "gigacode-icon.png",
	"license": "SEE LICENSE IN LICENSE",
	"main": "./out/extension.js",
	"l10n": "./l10n",
	"contributes": {
		"icons": {
			"gigacode-icon": {
				"description": "GigaCode icon",
				"default": {
					"fontPath": "gigacode.woff",
					"fontCharacter": "\\E900"
				}
			}
		},
		"commands": [
			{
				"command": "gigacode.new.chat",
				"title": "%gigacode.new.chat.command.description%",
				"icon": "$(add)",
				"category": "GigaCode"
			},
			{
				"command": "gigacode.chat.history.open",
				"title": "%gigacode.chat.history.command.description%",
				"icon": "$(comment-discussion)",
				"category": "GigaCode"
			},
			{
				"command": "gigacode.menu.open",
				"title": "%gigacode.menu.open.command.description%",
				"icon": "$(menu)",
				"category": "GigaCode"
			},
			{
				"command": "gigacode.docs.open",
				"title": "%gigacode.docs.open.command.description%",
				"category": "GigaCode"
			},
			{
				"command": "gigacode.settings.open",
				"title": "%gigacode.settings.open.command.description%",
				"category": "GigaCode"
			},
			{
				"command": "gigacode.version.check",
				"title": "%gigacode.version.check.command.description%",
				"category": "GigaCode"
			},
			{
				"command": "gigacode.chat.loggingInformationMessage",
				"title": "%gigacode.chat.loggingInformationMessage.command.description%",
				"category": "GigaCode"
			},
			{
				"command": "gigacode.chat.loggingInformationMessage.clear",
				"title": "%gigacode.chat.loggingInformationMessage.clear.command.description%",
				"category": "GigaCode",
				"enablement": "isDebug"
			},
			{
				"command": "gigacode.chatCodebase.showInfo",
				"title": "%gigacode.chatCodebase.showInfo.description%",
				"category": "GigaCode",
				"enablement": "isDebug"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "gigacode.new.chat",
					"group": "navigation@0",
					"when": "view == gigacode.sidebar"
				},
				{
					"command": "gigacode.chat.history.open",
					"group": "navigation@1",
					"when": "view == gigacode.sidebar"
				},
				{
					"command": "gigacode.menu.open",
					"group": "navigation@2",
					"when": "view == gigacode.sidebar"
				}
			]
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "gigacode",
					"title": "GigaCode",
					"icon": "gigacode-icon.png"
				}
			]
		},
		"views": {
			"gigacode": [
				{
					"type": "webview",
					"id": "gigacode.sidebar",
					"name": "GigaCode",
					"icon": "gigacode-icon.png",
					"contextualTitle": "GigaCode"
				}
			]
		},
		"configuration": [
			{
				"title": "Autocompletion",
				"properties": {
					"gigacode.showCompletionsInline": {
						"type": "boolean",
						"markdownDescription": "%gigacode.showCompletionsInline.description%",
						"default": true,
						"order": 1
					},
					"gigacode.inlineCompletionColor": {
						"type": "string",
						"enum": [
							"red",
							"pink",
							"yellow",
							"green",
							"blue"
						],
						"order": 2
					},
					"gigacode.inlineHints": {
						"type": "boolean",
						"default": true,
						"description": "%gigacode.inlineHints.description%",
						"order": 3
					},
					"gigacode.lookupPriority": {
						"type": "boolean",
						"default": false,
						"description": "%gigacode.lookupPriority.description%",
						"order": 4
					},
					"gigacode.common.wholeLineReplacement": {
						"type": "boolean",
						"description": "%gigacode.common.wholeLineReplacement.description%",
						"default": false,
						"order": 5
					}
				}
			},
			{
				"title": "CodeChat",
				"properties": {}
			},
			{
				"title": "Cloud.ru Identification",
				"properties": {
					"gigacode.cloudIdentify": {
						"type": "boolean",
						"description": "%gigacode.cloudIdentify.description%",
						"default": false
					}
				}
			}
		],
		"keybindings": [
			{
				"key": "right",
				"command": "gigacode.inlineSuggest.hide",
				"when": "editorTextFocus && inlineSuggestionVisible"
			},
			{
				"key": "delete",
				"command": "gigacode.inlineSuggest.hide",
				"when": "editorTextFocus && inlineSuggestionVisible"
			},
			{
				"key": "Escape",
				"command": "gigacode.inlineSuggest.hideViaEsc",
				"when": "editorTextFocus && inlineSuggestionVisible"
			},
			{
				"key": "cmd+right",
				"command": "gigacode.inlineSuggest.acceptNextWord",
				"when": "editorTextFocus && inlineSuggestionVisible"
			},
			{
				"key": "shift+tab",
				"command": "gigacode.inlineSuggest.acceptNextLine",
				"when": "editorTextFocus && inlineSuggestionVisible"
			},
			{
				"key": "alt+[",
				"command": "gigacode.inlineSuggest.showPrevious",
				"when": "editorTextFocus && inlineSuggestionVisible"
			},
			{
				"key": "alt+]",
				"command": "gigacode.inlineSuggest.showNext",
				"when": "editorTextFocus && inlineSuggestionVisible"
			},
			{
				"key": "tab",
				"command": "editor.action.inlineSuggest.commit",
				"when": "!config.gigacode.lookupPriority && inlineSuggestionVisible && !editorTabMovesFocus"
			},
			{
				"key": "alt+\\",
				"command": "gigacode.inlineSuggest.trigger",
				"when": "editorTextFocus"
			},
			{
				"key": "meta+y",
				"command": "gigacode.chat.focus",
				"when": "editorTextFocus"
			},
			{
				"key": "meta+y",
				"command": "workbench.action.focusActiveEditorGroup",
				"when": "!editorTextFocus"
			},
			{
				"key": "delete",
				"command": "gigacode.deleteRightOverride",
				"when": "textInputFocus"
			},
			{
				"key": "backspace",
				"command": "gigacode.deleteLeftOverride",
				"when": "textInputFocus"
			}
		],
		"languages": [
			{
				"id": "bsl",
				"extensions": [
					".bsl"
				],
				"aliases": [
					"1C"
				]
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "webpack --mode production",
		"compile": "webpack --mode development --watch",
		"pretest": "npm run lint",
		"lint": "eslint src --ext ts",
		"test": "mocha",
		"coverage": "c8 --check-coverage npm run test",
		"package": "vsce package",
		"prebuild": "node ./prebuild.js",
		"build": "webpack --mode production"
	},
	"devDependencies": {
		"@types/chai": "4.3.4",
		"@types/cron": "1.7.3",
		"@types/debounce": "1.2.1",
		"@types/glob": "7.2.0",
		"@types/levenshtein": "1.0.3",
