{
    "compilerOptions": {
        "target" :"es2020",
        "module" :"esnext",
        "moduleResolution" :"bundler",
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*"]
}